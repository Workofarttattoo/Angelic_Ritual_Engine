# ── Agentic Ritual Engine – Environment Variables ──────────────────────
#
# Copy this file to .env and fill in the values.
#   cp .env.example .env

# ── Database ───────────────────────────────────────────────────────────
# SQLAlchemy connection URL.  SQLite (default) or PostgreSQL for prod.
RITUAL_DB_URL=sqlite:///data/ritual.db
# RITUAL_DB_URL=postgresql://user:password@localhost:5432/ritual_engine

# ── API Server ─────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info

# ── PDF / OCR ──────────────────────────────────────────────────────────
# Tesseract language (must have traineddata installed)
TESSERACT_LANG=eng
# Rendering DPI for pdf2image / poppler
PDF_RENDER_DPI=300

# ── Streamlit ──────────────────────────────────────────────────────────
STREAMLIT_SERVER_PORT=8501
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
